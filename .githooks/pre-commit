#!/bin/sh
# Pre-commit hook for hermes-tdata
# Mirrors all CI checks to catch issues BEFORE push

set -e

echo "🔍 Running pre-commit checks (mirrors CI)..."

# Format check
echo "  📝 [1/5] Checking formatting..."
cargo fmt --check

# Clippy
echo "  🔎 [2/5] Running clippy..."
cargo clippy --all-features -- -D warnings

# Tests
echo "  🧪 [3/5] Running tests..."
cargo test --quiet

# Docs (catches doc warnings)
echo "  📚 [4/5] Building docs..."
RUSTDOCFLAGS="-Dwarnings" cargo doc --no-deps --all-features --quiet

# MSRV check (requires rustup)
echo "  🔧 [5/5] Checking MSRV (1.85.0)..."
if command -v rustup >/dev/null 2>&1; then
    if rustup run 1.85.0 cargo check --all-features --quiet 2>/dev/null; then
        echo "       MSRV 1.85.0 ✓"
    else
        echo "       ⚠️  MSRV 1.85.0 not installed, skipping"
    fi
else
    echo "       ⚠️  rustup not found, skipping MSRV check"
fi

echo "✅ All pre-commit checks passed!"
